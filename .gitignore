# ── 构建缓存 ────────────────────────────────────────────────
# 压缩后的壁纸,由 build.sh 自动生成,可随时重建
.cache/

# 预览图输出(tools/preview*.mjs 生成)
tools/shots/*
!tools/shots/.gitkeep

# ── 本地资料(不随开源仓库发布)─────────────────────────────
# 设计笔记 / 排查记录,只在本机保留
docs/

# ── 编辑器 / IDE ────────────────────────────────────────────
.idea/
.vscode/
*.swp

# ── 依赖 ────────────────────────────────────────────────────
node_modules/

# ── 系统杂物 ────────────────────────────────────────────────
# Windows 下载产生的替代数据流标记
*:Zone.Identifier
.DS_Store
